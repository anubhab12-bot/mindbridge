# MindBridge environment template.
# Copy to `.env` (git-ignored) and replace every CHANGE_ME value. Never commit real secrets.
# Generate secrets with:  openssl rand -base64 48
# Generate the field encryption key with:  openssl rand -base64 32

# ---------------------------------------------------------------- API (apps/api)
NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/mindbridge
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_random
MFA_TOKEN_SECRET=CHANGE_ME_at_least_32_characters_long_random
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# Must be true anywhere served over HTTPS (always in staging/production).
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:4200
WEB_APP_URL=http://localhost:4200
# Base64 of exactly 32 random bytes (AES-256-GCM key for journals, chats, notes, messages).
FIELD_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes
FILE_SIGNING_SECRET=CHANGE_ME_at_least_32_characters_long_random
UPLOAD_DIR=./var/uploads
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MindBridge <no-reply@mindbridge.local>
QUEUES_ENABLED=true
SWAGGER_ENABLED=true
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CRISIS_RESOURCE_MAX_AGE_DAYS=180
ANALYTICS_MIN_GROUP_SIZE=5
CANCELLATION_NOTICE_HOURS=24
AI_DAILY_MESSAGE_QUOTA=200
AI_CONVERSATION_RETENTION_DAYS=365
ACCOUNT_DELETION_GRACE_DAYS=7
# none | jitsi  (video stays off until a provider is configured and reviewed)
VIDEO_PROVIDER=none
VIDEO_JITSI_DOMAIN=
LOG_LEVEL=info

# ---------------------------------------------------------------- API <-> AI service
AI_SERVICE_URL=http://localhost:8000
# Shared secret the API presents to the AI service. Same value in both services.
AI_SERVICE_TOKEN=CHANGE_ME_at_least_32_characters_long_random
AI_SERVICE_TIMEOUT_MS=20000

# ---------------------------------------------------------------- AI service (apps/ai-service)
# mock | openai_compatible | anthropic | ollama
AI_PROVIDER=mock
# Model names are configuration, not code. Leave empty for the mock provider.
AI_MODEL=
AI_API_KEY=
# For openai_compatible / ollama: the provider's base URL, e.g. http://localhost:11434 for Ollama.
AI_BASE_URL=
AI_PROVIDER_TIMEOUT_SECONDS=15
AI_PROVIDER_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=600
# keyword | provider  (provider = also ask the LLM to classify risk; rules always run)
AI_RISK_CLASSIFIER=keyword
AI_RAG_ENABLED=true
AI_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Initial admin (CLI seed only)
# Used only by `npm run seed:admin`; prefer the interactive prompt instead of setting this.
ADMIN_PASSWORD=
